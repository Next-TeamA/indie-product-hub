# ==========================================
# Core
# ==========================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Postgres direct connection (for LangGraph checkpointer + pgvector)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8001
ENCRYPTION_KEY=your-fernet-encryption-key

# ==========================================
# LLM Providers
# ==========================================
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ==========================================
# Media Generation
# ==========================================
# fal.ai (Kling / Veo / Sora / Flux)
FAL_API_KEY=your-fal-api-key
FAL_WEBHOOK_SECRET=your-fal-webhook-secret

# ElevenLabs (TTS, voice clone)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Korean voice (multilingual_v2)
ELEVENLABS_DEFAULT_VOICE_ID_KO=your-korean-voice-id

# ==========================================
# RAG / Embeddings
# ==========================================
# Cohere (embed-v4 multilingual, rerank-3.5)
COHERE_API_KEY=your-cohere-api-key

# ==========================================
# Storage / Cache / Queue
# ==========================================
# Cloudflare R2 (영상 저장 - zero egress)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=launchpad-media
R2_PUBLIC_URL=https://media.your-domain.com

# Upstash Redis (Celery broker + tool result cache + rate limit counter)
REDIS_URL=rediss://default:[PASSWORD]@your-region.upstash.io:6379

# ==========================================
# SNS Platforms - 기존
# ==========================================
# X (Twitter) API v2
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret

# Threads
THREADS_APP_ID=your-threads-app-id
THREADS_CLIENT_SECRET=your-threads-client-secret

# ==========================================
# SNS Platforms - 신규
# ==========================================
# Instagram Graph API (Business/Creator account)
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_WEBHOOK_SECRET=your-instagram-webhook-secret

# YouTube Data API v3
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# LinkedIn Marketing API
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Bluesky (AT Protocol - 앱 패스워드 방식)
# 사용자별 앱 패스워드는 OAuth flow 대신 직접 입력받음

# ==========================================
# Deploy / Code - 기존
# ==========================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

VERCEL_CLIENT_ID=your-vercel-client-id
VERCEL_CLIENT_SECRET=your-vercel-client-secret
VERCEL_WEBHOOK_SECRET=your-vercel-webhook-secret

RAILWAY_CLIENT_ID=your-railway-client-id
RAILWAY_CLIENT_SECRET=your-railway-client-secret

# ==========================================
# Observability
# ==========================================
SENTRY_DSN=your-sentry-dsn
POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://us.i.posthog.com
# LangSmith (LangGraph tracing - 60일 시범 후 self-hosted 전환)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=launchpad-amp
LANGCHAIN_TRACING_V2=false

# ==========================================
# Notifications
# ==========================================
# Slack (승인 큐 알림)
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Resend (이메일)
RESEND_API_KEY=your-resend-api-key

# OneSignal (모바일 푸시)
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-api-key

# ==========================================
# Feature Flags
# ==========================================
# 기본 에이전트 백엔드 (legacy | langgraph | shadow)
DEFAULT_AGENT_BACKEND=legacy
# 자율성 기본 레벨 (manual | assisted | autonomous)
DEFAULT_AUTONOMY_LEVEL=assisted
# 일일 콘텐츠 발행 기본 한도
DEFAULT_DAILY_POST_BUDGET=10
# 월간 비용 기본 한도 (USD)
DEFAULT_MONTHLY_COST_BUDGET=50
